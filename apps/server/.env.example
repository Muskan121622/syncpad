# Backend config — copy to apps/server/.env and run with `node --env-file=.env src/index.js`,
# or export these in your PaaS dashboard (Fly/Railway/Render).

# Websocket port. PaaS platforms inject this themselves — respect it, never hardcode.
PORT=1234

# Rewind-history REST port. Ignored when SINGLE_PORT=1.
# HISTORY_PORT=1235

# 1 = serve /history, /streak and /health on the SAME port as the websocket.
# Required on any platform that exposes one port (Fly.io, Railway, Render).
SINGLE_PORT=0

# Where pad snapshots (.ydoc) and edit logs (history/*.ndjson) are written.
# Point this at a mounted volume in production or rooms forget everything on
# the next deploy/restart.
# DATA_DIR=/data

# Optional: Redis pub/sub fan-out so several server instances share one room.   
# Set this and you can scale horizontally behind a load balancer.
# REDIS_URL=redis://localhost:6379

# ──  TURN relay credentials (cross-city video/audio) ──────────────────────
# The server exposes GET /turn: it calls the provider with the secret below and
# returns short-lived iceServers to the browser. Keep the SECRET here (backend),
# NEVER in the frontend. Leave unset → /turn returns [] → app runs STUN-only.
# Xirsys dashboard → your app → credentials JSON gives all four values:
# XIRSYS_PATH=https://global.xirsys.net
# XIRSYS_IDENT=your_ident
# XIRSYS_SECRET=your-secret-uuid
# XIRSYS_CHANNEL=channelXXXXXX

# ──  Group-code judge (💻 tool) ───────────────────────────────────────────
# The server exposes POST /code/problems and /code/submissions: it forwards to
# the codeprep API with the bearer below, so the cpk_ key stays server-side and
# never ships in the public frontend bundle. Leave unset → /code returns 503 and
# the tool shows "judge not configured" (everything else keeps working).
# CODEPREP_API=https://codeprep-app.centralindia.cloudapp.azure.com/api/v1
# CODEPREP_API_KEY=cpk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
