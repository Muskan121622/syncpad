# Frontend config — copy to .env.local for local overrides.
# On Vercel these are Project Environment Variables (no file committed).

# Where the CRDT websocket lives. Leave UNSET for local dev: the client then
# defaults to ws://<current-host>:1234, which is what `npm run dev` starts.
# After deploying the server, set this to its public wss:// origin — the
# rewind/streak REST API is derived from it automatically (same host, no port).
VITE_WS_URL=wss://syncpad-ws.fly.dev

# Only needed if the REST API is NOT on the ws host (e.g. split across two
# services). Overrides the derivation above.
# VITE_HISTORY_URL=https://syncpad-ws.fly.dev

# ──  TURN relay (cross-city video/audio) ─────────────────────────────────
# Nothing to set here anymore. The browser mints relay credentials from OUR
# backend (GET <api-host>/turn), which holds the Xirsys/OpenRelay secret. So the
# frontend needs NO TURN env — just make sure VITE_WS_URL points at the deployed
# server (the /turn host is derived from it). Provider secrets live in the
# server's env — see apps/server/.env.example (XIRSYS_*).
