# Frontend config — copy to .env.local for local overrides.
# On Vercel these are Project Environment Variables (no file committed).

# Where the CRDT websocket lives. Leave UNSET for local dev: the client then
# defaults to ws://<current-host>:1234, which is what `npm run dev` starts.
# After deploying the server, set this to its public wss:// origin — the
# rewind/streak REST API is derived from it automatically (same host, no port).
VITE_WS_URL=wss://syncpad-ws.fly.dev

# Only needed if the REST API is NOT on the ws host (e.g. split across two
# services). Overrides the derivation above.
# VITE_HISTORY_URL=https://syncpad-ws.fly.dev

# ──  TURN relay (cross-city video/audio) ─────────────────────────────────
# WebRTC needs a public relay when both peers sit behind hard/symmetric NAT
# (different cities, mobile networks, AP-isolated wifi). Without a WORKING TURN
# server the call connects in signaling but zero media flows → dark tiles.
# Self-host coturn (see infra/turn/) and point these at it. On Vercel set the
# same three as Project Environment Variables. Leave blank for LAN-only dev.
#   URLS is comma-separated; include the ?transport=tcp variant so clients
#   behind UDP-blocking ISPs still relay over TCP on the same port.
#   (turns:/TLS needs a real cert — add it later; plain turn: works day one.)
# VITE_TURN_URLS=turn:YOUR_ORACLE_PUBLIC_IP:3478,turn:YOUR_ORACLE_PUBLIC_IP:3478?transport=tcp
# VITE_TURN_USER=syncpad
# VITE_TURN_PASS=a-strong-secret-you-chose
